---
config:
  flowchart:
    nodeSpacing: 45
    rankSpacing: 100
    wrappingWidth: 300
---
flowchart TB
    start(("開始"))
    NEW["NEW<br/>作成されたが、まだ開始していない"]
    R["RUNNABLE<br/>実行できる・実行中"]
    B["BLOCKED<br/>ロックを待っている<br/>―――――――<br/>ロックを取得すると戻る"]
    W["WAITING<br/>通知を待っている<br/>―――――――<br/>notify()、notifyAll()、<br/>unpark()で戻る"]
    TW["TIMED_WAITING<br/>指定した時間だけ待つ<br/>―――――――<br/>時間の経過、<br/>割り込みで戻る"]
    T["TERMINATED<br/>実行が終わった"]

    start -->|"new Thread()"| NEW
    NEW -->|"start()"| R
    R -->|"synchronized"| B
    R -->|"wait()、join()、park()"| W
    R -->|"sleep(millis)など"| TW
    R -->|"run()の終了、例外"| T
    B -.-> R
    W -.-> R
    TW -.-> R

    style R fill:#e3f2fd,stroke:#1565c0
    style T fill:#f5f5f5,stroke:#9e9e9e
