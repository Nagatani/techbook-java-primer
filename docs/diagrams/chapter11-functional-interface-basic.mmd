classDiagram
    direction LR

    class Function~T,R~ {
        <<interface>>
        +apply(T t) R
        +compose(Function) Function
        +andThen(Function) Function
    }

    class UnaryOperator~T~ {
        <<interface>>
        +apply(T t) T
    }

    class Consumer~T~ {
        <<interface>>
        +accept(T t) void
        +andThen(Consumer) Consumer
    }

    class Supplier~T~ {
        <<interface>>
        +get() T
    }

    class Predicate~T~ {
        <<interface>>
        +test(T t) boolean
        +and(Predicate) Predicate
        +or(Predicate) Predicate
        +negate() Predicate
    }

    Function~T,R~ <|-- UnaryOperator~T~ : extends

    note "どれも@Functional<br/>Interfaceが付いている"
    note for Function "T型を受け取り<br/>R型を返す関数"
    note for Consumer "T型を受け取り<br/>何も返さない"
    note for Supplier "引数なしで<br/>T型を返す"
    note for Predicate "T型を受け取り<br/>booleanを返す"
