        entry3["key: 'city'<br/>value: 'Tokyo'<br/>hash: 0x5E65"]
        entry4["key: 'id'<br/>value: 1001<br/>hash: 0x7E53"]
        
        buckets --> b0
        buckets --> b1
        buckets --> b2
