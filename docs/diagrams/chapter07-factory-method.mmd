classDiagram
    direction LR
    class DocumentFactory {
        <<abstract>>
        +createDocument()*
        +newDocument() Document
    }
    class WordDocumentFactory {
        +createDocument()
    }
    class PdfDocumentFactory {
        +createDocument()
    }
    class Document {
        <<interface>>
        +open() void
        +save() void
        +close() void
    }
    class WordDocument
    class PdfDocument
    DocumentFactory <|-- WordDocumentFactory
    DocumentFactory <|-- PdfDocumentFactory
    Document <|.. WordDocument
    Document <|.. PdfDocument
    WordDocumentFactory ..> WordDocument : 作る
    PdfDocumentFactory ..> PdfDocument : 作る
