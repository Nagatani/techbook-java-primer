classDiagram
    direction LR

    class Iterable~T~ {
        <<interface>>
        +iterator() Iterator~T~
    }

    class Collection~E~ {
        <<interface>>
        +size() int
        +contains(Object) boolean
        +add(E) boolean
        +remove(Object) boolean
    }

    class List~E~ {
        <<interface>>
        +get(int) E
        +set(int, E) E
        +indexOf(Object) int
    }

    class Set~E~ {
        <<interface>>
        重複要素なし
    }

    class Queue~E~ {
        <<interface>>
        +offer(E) boolean
        +poll() E
    }

    class Map~K,V~ {
        <<interface>>
        +put(K, V) V
        +get(Object) V
        +keySet() Set~K~
        +values() Collection~V~
    }

    class ArrayList~E~ {
        動的配列
    }
    class LinkedList~E~ {
        双方向リンクリスト
    }
    class HashSet~E~ {
        ハッシュテーブル
    }
    class TreeSet~E~ {
        赤黒木（ソート済み）
    }
    class HashMap~K,V~ {
        ハッシュテーブル
    }
    class TreeMap~K,V~ {
        赤黒木（キーでソート）
    }

    Iterable <|-- Collection
    Collection <|-- List
    Collection <|-- Set
    Collection <|-- Queue
    List <|.. ArrayList
    List <|.. LinkedList
    Queue <|.. LinkedList
    Set <|.. HashSet
    Set <|.. TreeSet
    Map <|.. HashMap
    Map <|.. TreeMap

    note for Map "キーと値のペアを格納<br/>Collectionとは独立した階層"
