---
config:
  themeCSS: ".tick text { font-size: 14px; }"
  gantt:
    useWidth: 900
    fontSize: 16
    sectionFontSize: 16
    barHeight: 26
    barGap: 6
    leftPadding: 150
    gridLineStartPadding: 30
---
gantt
    dateFormat HH:mm
    axisFormat %M分
    tickInterval 5minute

    section シェフ1人
    Aの前菜     :a1, 00:00, 5m
    Aのメイン   :a2, after a1, 15m
    Aのデザート :a3, after a2, 5m
    Bの前菜     :a4, after a3, 5m
    Bのメイン   :a5, after a4, 15m
    Bのデザート :a6, after a5, 5m

    section シェフ1（3人）
    Aの前菜     :b1, 00:00, 5m
    Bの前菜     :b2, after b1, 5m
    section シェフ2（3人）
    Aのメイン   :c1, 00:00, 15m
    Bのメイン   :c2, after c1, 15m
    section シェフ3（3人）
    Aのデザート :d1, 00:00, 5m
    Bのデザート :d2, after d1, 5m
