flowchart TB
    T["Throwable<br/>getMessage()、getCause()<br/>printStackTrace()"]
    E["Error（エラー）<br/>回復できない問題<br/>例: OutOfMemoryError、<br/>StackOverflowError"]
    X["Exception<br/>回復できる問題"]
    R["RuntimeException<br/>（非検査例外）<br/>プログラムの誤り"]
    IO["IOException<br/>（検査例外）<br/>入出力の失敗"]
    SQL["SQLException<br/>（検査例外）<br/>SQLの実行の失敗"]
    NPE["NullPointer<br/>Exception"]
    AIOOBE["ArrayIndexOutOf<br/>BoundsException"]
    IAE["IllegalArgument<br/>Exception"]
    NFE["NumberFormat<br/>Exception"]

    T --> E
    T --> X
    X --> R
    X --> IO
    X --> SQL
    R --> NPE
    R --> AIOOBE
    R --> IAE
    IAE --> NFE

    classDef error fill:#ffebee,stroke:#c62828
    classDef checked fill:#fff8e1,stroke:#f9a825
    classDef unchecked fill:#e3f2fd,stroke:#1565c0
    class E error
    class X,IO,SQL checked
    class R,NPE,AIOOBE,IAE,NFE unchecked
