classDiagram
    direction LR

    class OuterClass {
        -int outerField
        +outerMethod() void
    }

    class InnerClass {
        <<非static内部クラス>>
        -int innerField
        +innerMethod() void
        +accessOuter() void
    }

    class StaticNestedClass {
        <<static内部クラス>>
        -int staticField
        +staticMethod() void
    }

    class LocalClass {
        <<ローカルクラス>>
        +localMethod() void
        +accessEnclosing() void
    }

    class AnonymousClass {
        <<匿名クラス>>
        +compare(T o1, T o2) int
    }

    class Comparator~T~ {
        <<interface>>
        +compare(T o1, T o2) int
    }

    OuterClass *-- InnerClass : contains
    OuterClass *-- StaticNestedClass : contains
    OuterClass ..> LocalClass : creates
    OuterClass ..> AnonymousClass : creates
    AnonymousClass ..|> Comparator : implements

    note for InnerClass "外部クラスのインスタンスに紐付き<br/>外部クラスのメンバーにアクセスできる"
    note for StaticNestedClass "外部クラスのインスタンスに依存せず<br/>外部クラスのstaticメンバーだけを使える"
    note for LocalClass "メソッドの中で定義し、メソッドの<br/>ローカル変数（実質的final）を使える"
    note for AnonymousClass "名前を持たず、インターフェイスや<br/>抽象クラスをその場で実装する"
