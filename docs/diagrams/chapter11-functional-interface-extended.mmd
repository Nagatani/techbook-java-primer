classDiagram
    direction LR

    class BiFunction~T,U,R~ {
        <<interface>>
        +apply(T t, U u) R
    }

    class BinaryOperator~T~ {
        <<interface>>
        +apply(T t1, T t2) T
    }

    class BiConsumer~T,U~ {
        <<interface>>
        +accept(T t, U u) void
    }

    class BiPredicate~T,U~ {
        <<interface>>
        +test(T t, U u) boolean
    }

    class Runnable {
        <<interface>>
        +run() void
    }

    class Callable~V~ {
        <<interface>>
        +call() V
    }

    class Comparator~T~ {
        <<interface>>
        +compare(T o1, T o2) int
        +reversed() Comparator
        +thenComparing(...) Comparator
    }

    BiFunction~T,U,R~ <|-- BinaryOperator~T~ : extends

    note "どれも@Functional<br/>Interfaceが付いている"
    note for BiFunction "引数2つ<br/>結果を返す"
    note for BiConsumer "引数2つ<br/>何も返さない"
    note for BiPredicate "引数2つ<br/>booleanを返す"
    note for Runnable "引数も戻り値もなし"
    note for Callable "引数なし、戻り値あり<br/>例外を投げられる"
    note for Comparator "2つの値を比較"
