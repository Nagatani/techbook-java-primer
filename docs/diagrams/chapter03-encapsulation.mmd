---
config:
  flowchart:
    rankSpacing: 50
---
flowchart LR
    client["クライアントコード<br/>（クラスの外部）"]

    subgraph pub["BankAccountのpublicメソッド"]
        public1["+ deposit(double): void<br/>（正の金額だけ受け付ける）"]
        public2["+ getBalance(): double<br/>（読み取るだけ）"]
    end

    subgraph priv["privateなフィールド（カプセル化）"]
        private1["- double balance"]
    end

    client -->|"アクセス可能"| pub
    client -.-x|"直接アクセス不可"| priv

    public1 --> private1
    public2 --> private1

    style private1 fill:#faa,stroke:#333,stroke-width:2px
    style public1 fill:#afa,stroke:#333,stroke-width:2px
    style public2 fill:#afa,stroke:#333,stroke-width:2px
