{
  "name": "techbook-java-primer",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npm run mermaid:convert && npx vivliostyle build",
    "build4web": "npm run mermaid:convert && npx vivliostyle build -o dist",
    "preview": "npm run mermaid:convert && npx vivliostyle preview",
    "mermaid:convert": "node scripts/convert-mermaid-to-images.js",
    "index": "node scripts/build-book-index.js",
    "index:check": "node scripts/build-book-index.js --check",
    "check:java": "node scripts/check-java-samples.js",
    "check:java:run": "node scripts/check-java-samples.js --run",
    "check:samples": "node scripts/sample-code.js check",
    "samples:sync": "node scripts/sample-code.js sync",
    "samples:extract": "node scripts/sample-code.js extract",
    "lint": "npx textlint manuscripts/*.md",
    "lint:fix": "npx textlint --fix manuscripts/*.md",
    "lintadx": "npx textlint appendix/**/*.md",
    "lintadx:fix": "npx textlint --fix appendix/**/*.md",
    "check:compliance": "node scripts/check-claude-md-compliance.js",
    "fix:compliance": "node scripts/fix-claude-md-violations.js",
    "pre-commit": "npm run check:compliance && npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nagatani/techbook-java-primer.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Nagatani/techbook-java-primer/issues"
  },
  "homepage": "https://github.com/Nagatani/techbook-java-primer#readme",
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.17.1",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
    "@vivliostyle/cli": "^11.4.0",
    "@vivliostyle/theme-techbook": "^3.1.0",
    "glob": "^14.0.4",
    "textlint": "^15.8.0",
    "textlint-rule-ja-hiraku": "^1.4.0",
    "textlint-rule-no-mixed-zenkaku-and-hankaku-alphabet": "^1.0.1",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-preset-japanese": "^10.0.4",
    "textlint-rule-preset-jtf-style": "^3.0.3",
    "textlint-rule-prh": "^6.1.1",
    "textlint-rule-spellcheck-tech-word": "^5.0.0"
  }
}
