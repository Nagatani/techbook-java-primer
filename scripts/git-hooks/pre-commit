#!/bin/sh
# 共有のpre-commitフック（有効にする: git config core.hooksPath scripts/git-hooks）
# 速く誤検出の少ない検査だけを行う。textlintやサンプルの検査はCI（.github/workflows/check.yml）で行う。

cd "$(git rev-parse --show-toplevel)" || exit 1

if ! command -v node >/dev/null 2>&1; then
    echo "pre-commit: nodeが見つからないため検査を省略しました"
    exit 0
fi

# 1. 章・演習・付録B・用語集・相互参照ガイドの食い違い（あればコミットを止める）
if ! node scripts/check-structure.js; then
    echo ""
    echo "pre-commit: 構成の食い違いがあるためコミットを中止しました（npm run check:structure）"
    exit 1
fi

# 2. CLAUDE.mdのルール（エラーがあればコミットを止める。報告は失敗したときだけ表示）
out=$(node scripts/check-claude-md-compliance.js 2>&1)
if [ $? -ne 0 ]; then
    echo "$out" | tail -40
    echo ""
    echo "pre-commit: CLAUDE.mdのルール違反があるためコミットを中止しました（npm run check:compliance）"
    exit 1
fi
echo "CLAUDE.mdのルール: エラーなし"

# 3. 主張の台帳（付録Bのclaims.yml、本文のdocs/claims/chapterXX.yml）と解説・本文の対応、フラグ名（Javaの検証はしない。約1秒）
#    コミットに含まれる節・章だけを検査する（ほかの節の書きかけの作業でコミットが止まらないように）
secs=$(git diff --cached --name-only | sed -n -e 's#^appendix/\(b[0-9][0-9]\)-.*#\1#p' -e 's#^manuscripts/chapter\([0-9][0-9]\)-.*#ch\1#p' -e 's#^docs/claims/chapter\([0-9][0-9]\).*#ch\1#p' | sort -u | tr '\n' ' ')
out=""
status=0
if [ -n "$secs" ]; then
    # shellcheck disable=SC2086
    out=$(node scripts/check-claims.js --static $secs 2>&1)
    status=$?
fi
if [ $status -ne 0 ]; then
    echo "$out" | tail -30
    echo ""
    echo "pre-commit: 主張の台帳と解説・本文が食い違っているためコミットを中止しました（node scripts/check-claims.js --static）"
    exit 1
fi
echo "主張の台帳: 問題なし"

# 4. 本文のインラインコードに書いたJDKのAPI名（コミットする原稿だけ。javaがなければ省く）
mss=$(git diff --cached --name-only --diff-filter=ACM | sed -n 's#^manuscripts/\(.*\.md\)$#\1#p' | tr '\n' ' ')
if [ -n "$mss" ] && command -v java >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    out=$(node scripts/check-api-names.js $mss 2>&1)
    if [ $? -ne 0 ]; then
        echo "$out" | tail -20
        echo ""
        echo "pre-commit: 本文にJDK 25にないAPI名か削除予定のAPIがあるためコミットを中止しました（npm run check:api-names）"
        exit 1
    fi
    echo "APIの名前: 問題なし"
fi

exit 0
